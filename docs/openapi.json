          "200": {
            "description": "Service greeting",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "example": "Hello Aurora Chasers!"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing application marker",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
