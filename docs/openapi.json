              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream service unavailable or malformed response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Firebase initialization unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "504": {
            "description": "Upstream service timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "tags": [
          "Aurora"
        ]
      }
    },
    "/aurora/swpc": {
      "post": {
        "operationId": "AuroraController_getAllSwpcData",
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptionalCoordinatesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Combined NOAA datasets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "forecastSolarCycle",
                    "forecastSolarWind",
                    "forecastKp",
                    "forecastTwentySevenDays",
                    "instantKp"
                  ],
                  "properties": {
                    "forecastSolarCycle": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "timeTag",
                          "predictedSsn",
                          "predictedSolarFlux"
                        ],
                        "properties": {
                          "timeTag": {
                            "type": "string"
                          },
                          "predictedSsn": {
                            "oneOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "string",
                                "nullable": true
                              }
                            ]
                          },
                          "predictedSolarFlux": {
                            "oneOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "string",
                                "nullable": true
                              }
                            ]
                          }
                        }
                      }
                    },
                    "forecastSolarWind": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "forecastKp": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "kpIndex",
                          "timeTag"
                        ],
                        "properties": {
                          "kpIndex": {
                            "type": "number",
                            "nullable": true
                          },
                          "timeTag": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "forecastTwentySevenDays": {
                      "type": "string"
                    },
                    "instantKp": {
                      "type": "object",
                      "additionalProperties": true,
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing application marker",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream service unavailable or malformed response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Firebase initialization unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "504": {
            "description": "Upstream service timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "tags": [
          "Aurora"
        ]
      }
    },
    "/aurora/map/ovation": {
      "get": {
        "operationId": "AuroraController_getOvation",
        "parameters": [
          {
            "name": "lat",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": -90,
              "maximum": 90,
              "type": "number"
            }
          },
          {
            "name": "lng",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": -180,
              "maximum": 180,
              "type": "number"
            }
          },
          {
            "name": "long",
            "required": false,
            "in": "query",
            "description": "Legacy longitude alias, retained for existing mobile clients.",
            "schema": {
              "minimum": -180,
              "maximum": 180,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Map coordinate tuples, or probability for a complete coordinate pair; empty body if no coordinate matches",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      }
                    },
                    {
                      "type": "number",
                      "description": "Probability for the requested coordinate"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing application marker",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream service unavailable or malformed response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Firebase initialization unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "504": {
            "description": "Upstream service timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "tags": [
          "Aurora"
        ]
      }
    },
