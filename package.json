{
  "name": "aurora-proxy-nest",
  "version": "0.0.1",
  "author": "Morgan N aka Ichoui",
  "description": "API for Aurorapp - Northern Light app, available on the Play Store only, for Aurora Borealis",
  "private": true,
  "licence": "GPL-3.0-only",
  "scripts": {
    "start": "npm run build | firebase emulators:start --only functions",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "build": "nest build",
    "firebase:serve": "firebase serve --only functions",
    "firebase:emulator": "firebase emulators:start",
    "firebase:shell": "firebase functions:shell",
    "firebase:logs": "firebase functions:log",
    "firebase:deploy": "firebase deploy --only functions",
    "build:prod": "nest build",
    "deploy": "npm-run-all build:prod firebase:deploy",
    "lint": "eslint \"{src}/**/*.ts\" --fix",
    "prettier": "prettier --write \"**/*.{js,ts,css,scss,html}\"",
    "prettier:check": "prettier --check \"**/*.{js,ts,css,scss,html}\""
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/typeorm": "^11.0.0",
    "@types/chart.js": "^2.9.41",
    "axios": "^1.13.2",
    "cache-manager": "^7.2.8",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.3",
    "nest-winston": "^1.10.2",
    "pg": "^8.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.12",
    "@types/cache-manager": "^4.0.6",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.3.0",
    "firebase-functions-test": "^3.3.0",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "main": "dist/src/main.js",
  "engines": {
    "node": "18"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
