{
  "name": "aurora-proxy-nest",
  "version": "0.0.1",
  "author": "Morgan N aka Ichoui",
  "description": "Shared Aurora Borealis API for Aurorapp mobile clients",
  "private": true,
  "scripts": {
    "start": "npm run build && firebase emulators:start --only functions",
    "dev:watch": "nest build --watch --watchAssets",
    "dev:emulator": "firebase emulators:start --only functions",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "build": "nest build",
    "firebase:serve": "npm run start",
    "firebase:emulator": "firebase emulators:start",
    "firebase:shell": "firebase functions:shell",
    "firebase:logs": "firebase functions:log",
    "firebase:deploy": "firebase deploy --only functions",
    "build:prod": "nest build",
    "deploy": "npm run build:prod && npm run firebase:deploy",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "lint:fix": "eslint . --fix",
    "docs:generate": "npm run build && node scripts/generate-openapi.cjs",
    "docs:check": "npm run build && node scripts/generate-openapi.cjs --check"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/cache-manager": "^12.0.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "axios": "^1.21.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "keyv": "^5.6.0",
    "nest-winston": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.34.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "main": "dist/src/main.js",
  "engines": {
    "node": "^22.22.3"
  },
  "license": "GPL-3.0-only"
}
